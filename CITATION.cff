cff-version: 1.2.0
message: "If you use MechFit.jl, please cite it as below. If you use its QuantDiffForecast-compatible layer, please also cite QuantDiffForecast (see references)."
title: "MechFit.jl: mechanistic epidemic model fitting, forecasting and ensembles in Julia"
type: software
version: 0.1.0
date-released: 2026-11-11
license: MIT
repository-code: "https://github.com/rajsubediresearch/MechFit.jl"
doi: 10.5281/zenodo.24133692
